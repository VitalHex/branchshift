{
  "name": "branchshift",
  "displayName": "BranchShift — JetBrains-style Git for VS Code",
  "publisher": "strNewBee",
  "description": "Keep your JetBrains-style Git workflow in VS Code and Cursor with Git graph, commit and shelf tools, branch comparison, rebase, merge, conflicts, and multi-repo support.",
  "version": "0.6.2",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/strNewBee/branchshift"
  },
  "homepage": "https://github.com/strNewBee/branchshift#readme",
  "bugs": {
    "url": "https://github.com/strNewBee/branchshift/issues"
  },
  "galleryBanner": {
    "color": "#08172D",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "git graph",
    "git log",
    "git history",
    "git workflow",
    "source control",
    "scm",
    "commit",
    "branch",
    "merge",
    "rebase",
    "cherry-pick",
    "stash",
    "shelf",
    "diff",
    "conflict resolution",
    "multi-repo",
    "multi-root workspace",
    "branch compare",
    "file history",
    "jetbrains",
    "intellij",
    "idea",
    "webstorm",
    "pycharm",
    "goland",
    "rider",
    "cursor",
    "vscode"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "branchshift-panel",
          "title": "BranchShift",
          "icon": "$(git-branch)"
        }
      ],
      "activitybar": [
        {
          "id": "branchshift-commit",
          "title": "Commit",
          "icon": "images/commit-icon.svg"
        }
      ]
    },
    "views": {
      "branchshift-panel": [
        {
          "type": "webview",
          "id": "branchshift.gitLog",
          "name": "Git Log"
        }
      ],
      "branchshift-commit": [
        {
          "type": "webview",
          "id": "branchshift.commitPanel",
          "name": "Commit"
        }
      ]
    },
    "commands": [
      {
        "command": "branchshift.refreshLog",
        "title": "Refresh Git Log",
        "icon": "$(refresh)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.openMergeEditor",
        "title": "Open Merge Editor",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.openConflicts",
        "title": "Conflicts",
        "icon": "$(git-merge)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.openMergeEditorFromSCM",
        "title": "Open in BranchShift Merge Editor",
        "icon": "$(git-merge)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.showFileHistory",
        "title": "(BranchShift) Show File History",
        "icon": "$(history)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.nextDiff",
        "title": "Next File Diff",
        "icon": "$(arrow-down)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.prevDiff",
        "title": "Previous File Diff",
        "icon": "$(arrow-up)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.commitPanel.refresh",
        "title": "Refresh Changes",
        "icon": "$(refresh)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.commitPanel.commit",
        "title": "Commit",
        "icon": "$(check)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.commitPanel.commitAndPush",
        "title": "Commit and Push",
        "icon": "$(cloud-upload)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.commitPanel.shelve",
        "title": "Shelve Changes",
        "icon": "$(archive)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.commitPanel.unshelve",
        "title": "Unshelve Changes",
        "icon": "$(package)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.openPushPanel",
        "title": "Push...",
        "icon": "$(cloud-upload)",
        "category": "BranchShift"
      },
      {
        "command": "branchshift.editSource",
        "title": "(BranchShift) Edit Source",
        "icon": "$(go-to-file)",
        "category": "BranchShift"
      }
    ],
    "menus": {
      "view/title": [],
      "scm/title": [
        {
          "command": "branchshift.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "branchshift.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "branchshift.showFileHistory",
          "when": "editorTextFocus",
          "group": "git@1"
        },
        {
          "command": "branchshift.editSource",
          "when": "isInDiffEditor && resourceScheme != file",
          "group": "git@2"
        }
      ],
      "explorer/context": [
        {
          "command": "branchshift.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "branchshift.openPushPanel",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "branchshift.nextDiff",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "editorFocus"
      },
      {
        "command": "branchshift.prevDiff",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "cd webview && pnpm run watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsce:package": "pnpm run package && pnpm run build:web && vsce package --no-dependencies",
    "vsce:publish": "pnpm run package && pnpm run build:web && vsce publish --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src webview/src",
    "test": "vscode-test",
    "build:web": "cd webview && pnpm run build",
    "build": "pnpm run compile && pnpm run build:web",
    "dev:web": "cd webview && pnpm run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "dependencies": {
    "node-diff3": "^3.2.0"
  }
}
